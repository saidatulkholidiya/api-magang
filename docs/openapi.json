    "/jurnal": {
      "post": {
        "tags": [
          "Jurnal"
        ],
        "summary": "Buat jurnal harian baru",
        "description": "Jurnal otomatis dimiliki pengguna yang login. `pesertaId` tidak boleh dikirim lewat body.\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateJurnalRequest"
              },
              "examples": {
                "sederhana": {
                  "summary": "Tanpa lampiran",
                  "value": {
                    "kegiatan": "Belajar unit testing dengan Jest dan Supertest"
                  }
                },
                "denganLampiran": {
                  "summary": "Dengan lampiran tangkapan layar",
                  "value": {
                    "kegiatan": "Menulis test untuk DTO dan service",
                    "hambatan": "Bingung cara mock repository",
                    "linkCommit": "https://github.com/budi/api-magang/commit/abc123",
                    "lampiran": [
                      {
                        "url": "https://contoh.com/ss1.png",
                        "keterangan": "Hasil npm test"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Jurnal berhasil dibuat",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JurnalResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      },
      "get": {
        "tags": [
          "Jurnal"
        ],
        "summary": "Daftar semua jurnal (khusus mentor)",
        "description": "Mengembalikan jurnal seluruh peserta dengan pagination.\n- Hanya role `mentor`. Peserta mendapat 403; gunakan `/me/jurnal` untuk jurnal sendiri.\n- `from` dan `to` memfilter berdasarkan tanggal pembuatan (format YYYY-MM-DD).\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Order"
          },
          {
            "in": "query",
            "name": "sortBy",
            "schema": {
              "type": "string",
              "enum": [
                "createdAt",
                "statusReview"
              ],
              "default": "createdAt"
            }
          },
          {
            "in": "query",
            "name": "statusReview",
            "schema": {
              "type": "string",
              "enum": [
                "belum",
                "sudah"
              ]
            }
          },
          {
            "in": "query",
            "name": "from",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "in": "query",
            "name": "to",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Daftar jurnal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JurnalListResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
